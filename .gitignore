# Forge checkout (symlink or clone via tools/setup-forge.sh; GPL upstream, ~800MB)
/forge
# Build outputs
/target/
**/target/
# Local logs / recordings
/tools/*.log
*.jsonl
!crates/**/fixtures/*.jsonl
!crates/arena/tests/replays/*.jsonl
# Packaging outputs
/packaging/appimage/tools/
/packaging/appimage/AppDir/
/squashfs-root/
*.AppImage
*.dmg
# Local reference screenshots (third-party, not redistributed)
/inspiration/
# Offline pack (tools/fetch-offline.sh): images, vendored crates, Maven repo, toolchain and Forge
# tarballs stay local (GBs; card art is Wizards' and not redistributed). Only the small data is committed.
/offline/*
!/offline/data/
!/offline/README.md
# Written by tools/fetch-offline.sh to point cargo at offline/vendor; machine-specific
/.cargo/config.toml
